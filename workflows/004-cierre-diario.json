    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Suma las ventas directas y los abonos del día por forma de pago (efectivo, tarjeta, bizum).\n// Nunca redondea los sumandos individuales de la app; solo redondea cada total resultante a 2 decimales (ADR-0002, D6).\n\nconst fecha = $('Fecha de hoy').first().json.fecha;\nconst itemsVentas = $('Pedir ventas del día').all();\nconst itemsAbonos = $('Pedir abonos del día').all();\n\nconst ventas = itemsVentas\n  .map((item) => item.json)\n  .filter((v) => v && v.id !== undefined && v.importe !== undefined);\n\nconst abonos = itemsAbonos\n  .map((item) => item.json)\n  .filter((a) => a && a.id !== undefined && a.importe !== undefined);\n\nconst rawVentas = { efectivo: 0, tarjeta: 0, bizum: 0 };\nfor (const v of ventas) {\n  if (rawVentas[v.forma_pago] !== undefined) {\n    rawVentas[v.forma_pago] += Number(v.importe);\n  }\n}\n\nconst rawAbonos = { efectivo: 0, tarjeta: 0, bizum: 0 };\nfor (const a of abonos) {\n  if (rawAbonos[a.forma_pago] !== undefined) {\n    rawAbonos[a.forma_pago] += Number(a.importe);\n  }\n}\n\nconst round2 = (n) => Math.round(n * 100) / 100;\n\nconst ventas_efectivo = round2(rawVentas.efectivo);\nconst ventas_tarjeta = round2(rawVentas.tarjeta);\nconst ventas_bizum = round2(rawVentas.bizum);\nconst total_ventas = round2(rawVentas.efectivo + rawVentas.tarjeta + rawVentas.bizum);\n\nconst abonos_efectivo = round2(rawAbonos.efectivo);\nconst abonos_tarjeta = round2(rawAbonos.tarjeta);\nconst abonos_bizum = round2(rawAbonos.bizum);\nconst total_abonos = round2(rawAbonos.efectivo + rawAbonos.tarjeta + rawAbonos.bizum);\n\nconst total_efectivo = round2(rawVentas.efectivo + rawAbonos.efectivo);\nconst total_tarjeta = round2(rawVentas.tarjeta + rawAbonos.tarjeta);\nconst total_bizum = round2(rawVentas.bizum + rawAbonos.bizum);\nconst total_general = round2(\n  rawVentas.efectivo +\n    rawVentas.tarjeta +\n    rawVentas.bizum +\n    rawAbonos.efectivo +\n    rawAbonos.tarjeta +\n    rawAbonos.bizum\n);\n\nconst num_ventas = ventas.length;\nconst num_abonos = abonos.length;\nconst num_movimientos = num_ventas + num_abonos;\nconst sinMovimientos = num_movimientos === 0;\n\nconst fmt = (n) =>\n  new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR' }).format(n);\n\nconst fechaEs = typeof DateTime !== 'undefined' && fecha\n  ? DateTime.fromISO(fecha).toFormat('dd/MM/yyyy')\n  : fecha;\n\nconst asunto_correo = sinMovimientos\n  ? `[Paso Firme] Cierre diario ${fechaEs} — Hoy no hubo movimientos`\n  : `[Paso Firme] Cierre diario ${fechaEs} — Total: ${fmt(total_general)}`;\n\nconst tablaResumen = [\n  `Ventas directas (${num_ventas}):`,\n  `  - Efectivo: ${fmt(ventas_efectivo)}`,\n  `  - Tarjeta: ${fmt(ventas_tarjeta)}`,\n  `  - Bizum: ${fmt(ventas_bizum)}`,\n  `  - Subtotal ventas: ${fmt(total_ventas)}`,\n  ``,\n  `Abonos de apartados (${num_abonos}):`,\n  `  - Efectivo: ${fmt(abonos_efectivo)}`,\n  `  - Tarjeta: ${fmt(abonos_tarjeta)}`,\n  `  - Bizum: ${fmt(abonos_bizum)}`,\n  `  - Subtotal abonos: ${fmt(total_abonos)}`,\n  ``,\n  `Total por forma de pago (${num_movimientos} movimientos):`,\n  `  - Efectivo: ${fmt(total_efectivo)}`,\n  `  - Tarjeta: ${fmt(total_tarjeta)}`,\n  `  - Bizum: ${fmt(total_bizum)}`,\n  `  - TOTAL GENERAL: ${fmt(total_general)}`\n].join('\\n');\n\nconst cuerpo_correo = sinMovimientos\n  ? `Hola Marisa,\\n\\nResumen del cierre diario del ${fechaEs}:\\n\\nHoy no hubo movimientos.\\n\\n${tablaResumen}\\n\\nUn saludo,\\nZapatería Paso Firme`\n  : `Hola Marisa,\\n\\nResumen del cierre diario del ${fechaEs}:\\n\\n${tablaResumen}\\n\\nUn saludo,\\nZapatería Paso Firme`;\n\nreturn [\n  {\n    json: {\n      fecha,\n      sinMovimientos,\n      num_ventas,\n      num_abonos,\n      num_movimientos,\n      ventas_efectivo,\n      ventas_tarjeta,\n      ventas_bizum,\n      total_ventas,\n      abonos_efectivo,\n      abonos_tarjeta,\n      abonos_bizum,\n      total_abonos,\n      total_efectivo,\n      total_tarjeta,\n      total_bizum,\n      total_general,\n      asunto_correo,\n      cuerpo_correo\n    }\n  }\n];\n"
      },
