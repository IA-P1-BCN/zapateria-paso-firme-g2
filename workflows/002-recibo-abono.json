    {
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "002-a02",
              "name": "importe_fmt",
              "value": "={{ Number($json.importe).toFixed(2).replace('.', ',') + ' €' }}",
              "type": "string"
            },
            {
              "id": "002-a03",
              "name": "abonado_fmt",
              "value": "={{ Number($json.abonado).toFixed(2).replace('.', ',') + ' €' }}",
              "type": "string"
            },
            {
              "id": "002-a04",
              "name": "pendiente_fmt",
              "value": "={{ Number($json.pendiente).toFixed(2).replace('.', ',') + ' €' }}",
              "type": "string"
            },
            {
              "id": "002-a05",
              "name": "fecha_limite_fmt",
              "value": "={{ String($json.fecha_limite).slice(0, 10).split('-').reverse().join('/') }}",
              "type": "string"
            },
            {
              "id": "002-a06",
              "name": "talla_txt",
              "value": "={{ String($json.talla ?? '').trim() ? ', talla ' + String($json.talla).trim() : '' }}",
              "type": "string"
            }
          ]
        }
      },
      "id": "002-n03",
      "name": "Formatear importes y fechas",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
